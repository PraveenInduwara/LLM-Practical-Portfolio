# Local Ollama model from the Lab 6 worksheet
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512

# Add/select university PDFs in this directory before using RAG search
LAB6_KNOWLEDGE_DIR=./data/knowledge_base

# Optional Google Desktop OAuth client JSON. Keep both files private and untracked.
GOOGLE_OAUTH_CLIENT_FILE=./credentials.json
GOOGLE_OAUTH_TOKEN_FILE=./data/google_token.json

# Optional, path-separated roots for read-only file_search. Example on Windows:
# LAB6_ALLOWED_SEARCH_ROOTS=D:\MSC AI;C:\Users\Student\Documents

