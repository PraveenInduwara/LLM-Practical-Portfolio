    "def generate_story(model, prompt=\"Once upon a time\", max_new_tokens=220, temperature=.8):\n",
    "    prompt_ids = torch.tensor([encode(prompt)], dtype=torch.long, device=DEVICE)\n",
    "    return decode(model.generate(prompt_ids, max_new_tokens, temperature)[0].tolist())\n",
    "\n",
    "baseline_story = generate_story(model)\n",
    "print(baseline_story)"
