   "source": [
    "@torch.no_grad()\n",
    "def full_validation_loss(model, batches=20):\n",
    "    model.eval()\n",
    "    losses = []\n",
    "    for _ in range(batches):\n",
    "        xb, yb = get_batch(val_ids)\n",
    "        _, loss = model(xb, yb)\n",
    "        losses.append(loss.item())\n",
    "    model.train()\n",
    "    return float(np.mean(losses))\n",
    "\n",
    "val_loss = full_validation_loss(model)\n",
    "perplexity = math.exp(val_loss)\n",
    "print(f\"Validation loss: {val_loss:.4f}\")\n",
    "print(f\"Validation perplexity: {perplexity:.2f}\")\n",
    "\n",
    "results_dir = Path.cwd().parent / \"results\"\n",
    "results_dir.mkdir(parents=True, exist_ok=True)\n",
    "history_df = pd.DataFrame(history)\n",
    "history_df.to_csv(results_dir / \"training_loss.csv\", index=False)\n",
    "fig, ax = plt.subplots(figsize=(8, 4.5))\n",
    "ax.plot(history_df.epoch, history_df.train_loss, marker=\"o\", label=\"Training loss\")\n",
