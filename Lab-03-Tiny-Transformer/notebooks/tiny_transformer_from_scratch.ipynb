   ],
   "source": [
    "sample_path = os.environ.get(\"TINYSTORIES_SAMPLE_PATH\")\n",
    "if sample_path and Path(sample_path).exists():\n",
    "    stories = json.loads(Path(sample_path).read_text(encoding=\"utf-8\"))\n",
    "else:\n",
    "    stream = load_dataset(\n",
    "        \"roneneldan/TinyStories\",\n",
    "        split=\"train\",\n",
    "        streaming=True,\n",
    "        cache_dir=str(Path(tempfile.gettempdir()) / \"tinystories_hf_cache\"),\n",
    "    )\n",
    "    stories = list(islice(stream, SAMPLE_SIZE))\n",
    "\n",
    "if not stories or \"text\" not in stories[0]:\n",
    "    raise ValueError(\"Expected TinyStories records with a text field.\")\n",
    "lengths = [len(story[\"text\"]) for story in stories]\n",
    "print(f\"Loaded {len(stories)} stories. Character length summary:\")\n",
    "display(pd.Series(lengths, name=\"characters\").describe(percentiles=[.25, .5, .75]).to_frame().round(1))\n",
    "for i, story in enumerate(stories[:3], 1):\n",
    "    print(f\"\\n--- Story {i} ({len(story['text'])} characters) ---\\n{story['text']}\\n\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "00000005",
   "metadata": {},
   "source": [
    "## 2–3. Character tokenization and next-token training sequences"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "00000006",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Train/validation characters: 196,058/47,795; vocabulary: 71\n",
      "Input and target shapes: (1, 30) (1, 30)\n",
      "Input: 'mes can be made better with a '\n",
      "Next-character target: 'es can be made better with a s'\n"
     ]
    }
   ],
   "source": [
    "indices = list(range(len(stories)))\n",
    "random.Random(SEED).shuffle(indices)\n",
    "cut = max(1, int(.8 * len(indices)))\n",
    "train_stories = [stories[i][\"text\"].strip() for i in indices[:cut]]\n",
    "val_stories = [stories[i][\"text\"].strip() for i in indices[cut:]]\n",
    "train_text = chr(10).join(train_stories)\n",
    "val_text = chr(10).join(val_stories)\n",
    "\n",
    "UNK = \"<unk>\"\n",
    "itos = [UNK] + sorted(set(train_text))\n",
    "stoi = {char: i for i, char in enumerate(itos)}\n",
    "encode = lambda text: [stoi.get(char, 0) for char in text]\n",
    "decode = lambda ids: \"\".join(itos[i] for i in ids if i < len(itos) and itos[i] != UNK)\n",
    "train_ids = torch.tensor(encode(train_text), dtype=torch.long)\n",
    "val_ids = torch.tensor(encode(val_text), dtype=torch.long)\n",
    "BLOCK_SIZE, BATCH_SIZE = 64, 32\n",
    "print(f\"Train/validation characters: {len(train_ids):,}/{len(val_ids):,}; vocabulary: {len(itos)}\")\n",
    "\n",
    "def get_batch(data, batch_size=BATCH_SIZE, block_size=BLOCK_SIZE):\n",
    "    starts = torch.randint(0, len(data) - block_size - 1, (batch_size,))\n",
    "    x = torch.stack([data[s:s + block_size] for s in starts])\n",
    "    y = torch.stack([data[s + 1:s + block_size + 1] for s in starts])\n",
    "    return x.to(DEVICE), y.to(DEVICE)\n",
    "\n",
    "x_example, y_example = get_batch(train_ids, batch_size=1, block_size=30)\n",
    "print(\"Input and target shapes:\", tuple(x_example.shape), tuple(y_example.shape))\n",
    "print(\"Input:\", repr(decode(x_example[0].tolist())))\n",
    "print(\"Next-character target:\", repr(decode(y_example[0].tolist())))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "00000007",
   "metadata": {},
   "source": [
    "## 4–5. Build and initialize the Transformer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "00000008",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Architecture ready: causal attention, token/position embeddings, MLP, residuals, LayerNorm, dropout.\n"
     ]
    }
   ],
   "source": [
    "class CausalSelfAttention(nn.Module):\n",
    "    def __init__(self, n_embd, n_head, dropout):\n",
    "        super().__init__()\n",
    "        self.attn = nn.MultiheadAttention(n_embd, n_head, dropout=dropout, batch_first=True)\n",
    "        self.dropout = nn.Dropout(dropout)\n",
    "\n",
    "    def forward(self, x):\n",
    "        steps = x.size(1)\n",
    "        mask = torch.triu(torch.ones(steps, steps, device=x.device, dtype=torch.bool), diagonal=1)\n",
    "        attended, _ = self.attn(x, x, x, attn_mask=mask, need_weights=False)\n",
    "        return self.dropout(attended)\n",
    "\n",
    "class TransformerBlock(nn.Module):\n",
    "    def __init__(self, n_embd, n_head, dropout):\n",
    "        super().__init__()\n",
    "        self.ln1 = nn.LayerNorm(n_embd)\n",
    "        self.attention = CausalSelfAttention(n_embd, n_head, dropout)\n",
    "        self.ln2 = nn.LayerNorm(n_embd)\n",
    "        self.ff = nn.Sequential(\n",
    "            nn.Linear(n_embd, 4 * n_embd), nn.GELU(),\n",
    "            nn.Linear(4 * n_embd, n_embd), nn.Dropout(dropout)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        x = x + self.attention(self.ln1(x))\n",
    "        return x + self.ff(self.ln2(x))\n",
    "\n",
    "class TinyTransformer(nn.Module):\n",
    "    def __init__(self, vocab_size, block_size, n_embd=64, n_head=4, n_layer=2, dropout=.1):\n",
    "        super().__init__()\n",
    "        if n_embd % n_head:\n",
    "            raise ValueError(\"n_embd must be divisible by n_head\")\n",
    "        self.block_size = block_size\n",
    "        self.token_embedding = nn.Embedding(vocab_size, n_embd)\n",
    "        self.position_embedding = nn.Embedding(block_size, n_embd)\n",
    "        self.embedding_dropout = nn.Dropout(dropout)\n",
    "        self.blocks = nn.Sequential(*[\n",
    "            TransformerBlock(n_embd, n_head, dropout) for _ in range(n_layer)\n",
    "        ])\n",
    "        self.final_norm = nn.LayerNorm(n_embd)\n",
    "        self.head = nn.Linear(n_embd, vocab_size, bias=False)\n",
    "        self.head.weight = self.token_embedding.weight\n",
    "        self.apply(self._init_weights)\n",
    "\n",
    "    @staticmethod\n",
    "    def _init_weights(module):\n",
    "        if isinstance(module, (nn.Linear, nn.Embedding)):\n",
    "            nn.init.normal_(module.weight, mean=0., std=.02)\n",
    "            if isinstance(module, nn.Linear) and module.bias is not None:\n",
    "                nn.init.zeros_(module.bias)\n",
    "        elif isinstance(module, nn.LayerNorm):\n",
    "            nn.init.ones_(module.weight)\n",
    "            nn.init.zeros_(module.bias)\n",
    "\n",
    "    def forward(self, ids, targets=None):\n",
    "        _, steps = ids.shape\n",
    "        positions = torch.arange(steps, device=ids.device)\n",
    "        x = self.embedding_dropout(\n",
    "            self.token_embedding(ids) + self.position_embedding(positions)\n",
    "        )\n",
    "        logits = self.head(self.final_norm(self.blocks(x)))\n",
    "        loss = None if targets is None else F.cross_entropy(\n",
    "            logits.reshape(-1, logits.size(-1)), targets.reshape(-1)\n",
    "        )\n",
    "        return logits, loss\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def generate(self, ids, max_new_tokens=240, temperature=.8):\n",
    "        self.eval()\n",
    "        for _ in range(max_new_tokens):\n",
    "            context = ids[:, -self.block_size:]\n",
    "            logits, _ = self(context)\n",
    "            logits = logits[:, -1, :] / max(temperature, 1e-5)\n",
    "            next_id = torch.multinomial(torch.softmax(logits, dim=-1), 1)\n",
    "            ids = torch.cat((ids, next_id), dim=1)\n",
    "        return ids\n",
    "\n",
    "print(\"Architecture ready: causal attention, token/position embeddings, MLP, residuals, LayerNorm, dropout.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "00000009",
   "metadata": {},
   "source": [
    "## 6–7. Train and monitor training/validation loss"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "0000000a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "baseline epoch 1/8: train=3.651, val=3.234\n",
      "baseline epoch 2/8: train=3.100, val=2.934\n",
      "baseline epoch 3/8: train=2.824, val=2.716\n",
      "baseline epoch 4/8: train=2.631, val=2.571\n",
      "baseline epoch 5/8: train=2.525, val=2.476\n",
      "baseline epoch 6/8: train=2.474, val=2.445\n",
      "baseline epoch 7/8: train=2.454, val=2.385\n",
      "baseline epoch 8/8: train=2.424, val=2.361\n"
     ]
    }
   ],
   "source": [
    "@torch.no_grad()\n",
    "def estimate_loss(model, batches=4):\n",
    "    model.eval()\n",
    "    values = {}\n",
    "    for name, data in [(\"train\", train_ids), (\"validation\", val_ids)]:\n",
    "        losses = []\n",
    "        for _ in range(batches):\n",
    "            xb, yb = get_batch(data)\n",
    "            _, loss = model(xb, yb)\n",
    "            losses.append(loss.item())\n",
    "        values[name] = float(np.mean(losses))\n",
    "    model.train()\n",
    "    return values\n",
    "\n",
    "def train_model(config, epochs, steps_per_epoch=10, run_name=\"baseline\"):\n",
    "    torch.manual_seed(SEED)\n",
    "    model = TinyTransformer(len(itos), BLOCK_SIZE, **config).to(DEVICE)\n",
    "    optimizer = torch.optim.AdamW(model.parameters(), lr=8e-4, weight_decay=.01)\n",
    "    history = []\n",
    "    for epoch in range(1, epochs + 1):\n",
    "        model.train()\n",
    "        recent_losses = []\n",
    "        for _ in range(steps_per_epoch):\n",
    "            xb, yb = get_batch(train_ids)\n",
    "            _, loss = model(xb, yb)\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            loss.backward()\n",
    "            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "            optimizer.step()\n",
    "            recent_losses.append(loss.item())\n",
    "        measured = estimate_loss(model)\n",
    "        row = {\n",
    "            \"run\": run_name, \"epoch\": epoch,\n",
    "            \"train_loss\": float(np.mean(recent_losses)),\n",
    "            \"validation_loss\": measured[\"validation\"]\n",
    "        }\n",
    "        history.append(row)\n",
    "        print(f\"{run_name} epoch {epoch}/{epochs}: train={row['train_loss']:.3f}, val={row['validation_loss']:.3f}\")\n",
    "    return model, history\n",
    "\n",
    "baseline_config = {\"n_embd\": 64, \"n_head\": 4, \"n_layer\": 2, \"dropout\": .1}\n",
    "model, history = train_model(baseline_config, epochs=8, steps_per_epoch=25, run_name=\"baseline\")"
   ]
  },
